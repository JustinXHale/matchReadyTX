rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPromoAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email in get(
          /databases/$(database)/documents/settings/admins
        ).data.emails;
    }

    match /publicFeeds/{appId} {
      allow read: if true;
      allow write: if isPromoAdmin();
    }

    match /settings/global {
      allow read: if true;
      allow write: if isPromoAdmin();
    }

    match /settings/admins {
      allow read: if isPromoAdmin();
      allow write: if false;
    }

    match /adminPromotions/{promoId} {
      allow read, write: if isPromoAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
