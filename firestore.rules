rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function onboardingComplete() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().get('profileComplete', false) == true;
    }
    function isAssigner(orgId) {
      return onboardingComplete()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid))
        && 'assigner' in get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.roles;
    }
    function isMember(orgId) {
      return onboardingComplete()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function isOrgMember(orgId, uid) {
      return exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid));
    }
    function defaultOrgId() {
      return 'lonestar';
    }
    function crewVisible(matchData) {
      return matchData.get('status', '') in ['mo_confirmed', 'crew_confirmed', 't72_team_pending', 't72_officials_pending', 'locked_confirmed'];
    }
    /** Assigner may patch profile + society-managed fields on an org member. */
    function assignerMemberPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'firstName', 'lastName', 'preferredName', 'displayName',
          'phone', 'smsOptIn',
          'homeStreet', 'homeUnit', 'homeCity', 'homeRegion', 'homePostalCode',
          'homeAddress', 'homeLat', 'homeLng',
          'roles', 'teamIds', 'fanTeamIds', 'fanTeamOther',
          'refereeLevel', 'assessedLevel', 'requestedAssessedLevel',
          'refereeingSince', 'birthday', 'jerseySize', 'shortsSize',
          'photoUrl', 'competitionAccess', 'profileComplete', 'updatedAt'
        ]);
    }

    /** Fields a user may patch on their own users/{uid} document. */
    function selfUserPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'uid', 'firstName', 'lastName', 'preferredName', 'displayName',
          'email', 'phone', 'smsOptIn',
          'homeStreet', 'homeUnit', 'homeCity', 'homeRegion', 'homePostalCode',
          'homeAddress', 'homeLat', 'homeLng',
          'roles', 'teamIds', 'fanTeamIds', 'fanTeamOther',
          'refereeLevel', 'requestedAssessedLevel',
          'refereeingSince', 'birthday', 'jerseySize', 'shortsSize',
          'photoUrl', 'competitionAccess', 'profileComplete', 'updatedAt'
        ])
        && request.resource.data.roles is list
        && ('assigner' in resource.data.roles) == ('assigner' in request.resource.data.roles);
    }
    function requestHasWorkingSocietyRole() {
      return request.resource.data.roles is list
        && (
          'official' in request.resource.data.roles
          || 'teamAdmin' in request.resource.data.roles
          || 'cmo' in request.resource.data.roles
          || 'assigner' in request.resource.data.roles
        );
    }
    function requestHasRefereeLensRole() {
      return request.resource.data.roles is list
        && (
          'official' in request.resource.data.roles
          || 'cmo' in request.resource.data.roles
        );
    }
    /** profileComplete: true only when required profile fields are present. */
    function selfProfileCompleteOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['profileComplete'])
        || request.resource.data.profileComplete == resource.data.profileComplete
        || (
          request.resource.data.profileComplete == true
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.roles is list
          && request.resource.data.roles.size() > 0
          && (
            !requestHasWorkingSocietyRole()
            || (
              request.resource.data.phone is string
              && request.resource.data.phone.size() > 0
              && request.resource.data.birthday is string
              && request.resource.data.birthday.size() > 0
            )
          )
          && (
            !requestHasRefereeLensRole()
            || (
              request.resource.data.homeStreet is string
              && request.resource.data.homeStreet.size() > 0
              && request.resource.data.homeCity is string
              && request.resource.data.homeCity.size() > 0
              && request.resource.data.homeRegion is string
              && request.resource.data.homeRegion.size() > 0
              && request.resource.data.homePostalCode is string
              && request.resource.data.homePostalCode.size() > 0
              && request.resource.data.refereeingSince is string
              && request.resource.data.refereeingSince.size() > 0
              && request.resource.data.jerseySize is string
              && request.resource.data.jerseySize.size() > 0
              && request.resource.data.shortsSize is string
              && request.resource.data.shortsSize.size() > 0
            )
          )
        );
    }

    function selfAssessedRequestOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['requestedAssessedLevel'])
        || request.resource.data.requestedAssessedLevel == null
        || (
          request.resource.data.requestedAssessedLevel is int
          && request.resource.data.requestedAssessedLevel >= 1
          && request.resource.data.requestedAssessedLevel <= 20
        );
    }

    match /users/{uid} {
      // Org directory: any member may read fellow members' profiles (names, roles).
      // Address/phone stay UI-gated for Scheduler where needed.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (isMember(defaultOrgId()) && isOrgMember(defaultOrgId(), uid))
      );
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('profileComplete', false) == false;
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && selfUserPatch()
          && selfProfileCompleteOk()
          && selfAssessedRequestOk())
        || (isAssigner(defaultOrgId())
          && isOrgMember(defaultOrgId(), uid)
          && assignerMemberPatch())
      );
      allow delete: if false;
    }

    /** Outbound email queue — Admin SDK / Cloud Functions only. */
    match /mail/{mailId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isAssigner(defaultOrgId())
      );
      allow create, update, delete: if false;
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow write: if isAssigner(orgId);

      match /members/{uid} {
        // Members see roster; self-read needed so new sign-ups can check/create their doc.
        allow read: if isMember(orgId)
          || (signedIn() && request.auth.uid == uid);
        // Self-join: official / teamAdmin / cmo / fan — never self-grant assigner.
        allow create: if signedIn() && (
          isAssigner(orgId)
          || (
            request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['roles', 'teamIds', 'joinedAt'])
            && request.resource.data.roles is list
            && request.resource.data.teamIds is list
            && !('assigner' in request.resource.data.roles)
          )
        );
        // Assigner manages anyone; members may update own roles / favorites but not grant or revoke assigner.
        allow update: if isAssigner(orgId) || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['roles', 'teamIds', 'fanTeamIds', 'fanTeamOther', 'updatedAt'])
          && request.resource.data.roles is list
          && request.resource.data.teamIds is list
          && ('assigner' in resource.data.roles) == ('assigner' in request.resource.data.roles)
        );
        allow delete: if isAssigner(orgId);
      }
      match /teams/{teamId} {
        allow read: if signedIn();
        allow write: if isAssigner(orgId);
      }
      match /matches/{matchId} {
        allow read: if isMember(orgId);
        allow write: if isAssigner(orgId)
          || (isMember(orgId) && memberMatchSelfServicePatch());

        function memberMatchSelfServicePatch() {
          let diff = request.resource.data.diff(resource.data).affectedKeys();
          return diff.hasOnly(['homeConfirmedAt', 'awayConfirmedAt', 'status', 't72TeamHome', 't72TeamAway', 'updatedAt'])
            && (
              request.resource.data.status == resource.data.status
              || request.resource.data.status in [
                'pending_team_review', 'team_confirmed', 'crew_pending',
                'needs_reconfirmation', 'change_proposed'
              ]
            );
        }

        match /crew/{slot} {
          allow read: if isAssigner(orgId)
            || (signedIn() && resource.data.userId == request.auth.uid)
            || (isMember(orgId) && crewVisible(get(/databases/$(database)/documents/orgs/$(orgId)/matches/$(matchId)).data));
          allow write: if isAssigner(orgId)
            || (signedIn() && resource.data.userId == request.auth.uid);
        }
        match /proposals/{proposalId} {
          function proposalMemberDoc() {
            return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
          }
          function isTeamAdminForTeam(teamId) {
            return isMember(orgId)
              && 'teamAdmin' in proposalMemberDoc().roles
              && teamId in proposalMemberDoc().teamIds;
          }
          function proposalOtherTeamId() {
            let matchData = get(/databases/$(database)/documents/orgs/$(orgId)/matches/$(matchId)).data;
            return resource.data.proposedByTeamId == matchData.homeTeamId
              ? matchData.awayTeamId
              : matchData.homeTeamId;
          }
          function proposalImmutableOk() {
            return resource.data.matchId == request.resource.data.matchId
              && resource.data.orgId == request.resource.data.orgId
              && resource.data.proposedByTeamId == request.resource.data.proposedByTeamId
              && resource.data.proposedByUserId == request.resource.data.proposedByUserId
              && resource.data.kickoffAt == request.resource.data.kickoffAt
              && resource.data.venueName == request.resource.data.venueName
              && resource.data.venueAddress == request.resource.data.venueAddress
              && resource.data.previousKickoffAt == request.resource.data.previousKickoffAt
              && resource.data.previousVenueName == request.resource.data.previousVenueName
              && resource.data.previousVenueAddress == request.resource.data.previousVenueAddress
              && resource.data.createdAt == request.resource.data.createdAt;
          }
          function proposalCreateShape() {
            let matchData = get(/databases/$(database)/documents/orgs/$(orgId)/matches/$(matchId)).data;
            return (
                request.resource.data.proposedByTeamId == matchData.homeTeamId
                || request.resource.data.proposedByTeamId == matchData.awayTeamId
              )
              && request.resource.data.get('otherTeamAcceptedAt', null) == null
              && request.resource.data.get('otherTeamDeniedAt', null) == null
              && request.resource.data.get('assignerAckAt', null) == null;
          }

          allow read: if isMember(orgId);
          allow create: if isMember(orgId)
            && request.resource.data.matchId == matchId
            && request.resource.data.orgId == orgId
            && request.resource.data.status == 'pending'
            && request.resource.data.proposedByUserId == request.auth.uid
            && isTeamAdminForTeam(request.resource.data.proposedByTeamId)
            && proposalCreateShape();
          allow update: if isMember(orgId)
            && resource.data.matchId == matchId
            && resource.data.orgId == orgId
            && proposalImmutableOk()
            && resource.data.status == 'pending'
            && (
              (
                isTeamAdminForTeam(proposalOtherTeamId())
                && request.resource.data.status == 'pending'
                && !resource.data.otherTeamAcceptedAt
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'otherTeamAcceptedAt', 'otherTeamAcceptedByUserId',
                    'otherTeamAcceptedByName', 'updatedAt'
                  ])
                && request.resource.data.otherTeamAcceptedByUserId == request.auth.uid
              )
              || (
                isTeamAdminForTeam(proposalOtherTeamId())
                && request.resource.data.status == 'rejected_by_other_team'
                && request.resource.data.denyReason is string
                && request.resource.data.denyReason.size() > 0
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'status', 'otherTeamDeniedAt', 'otherTeamDeniedByUserId',
                    'otherTeamDeniedByName', 'denyReason', 'updatedAt'
                  ])
                && request.resource.data.otherTeamDeniedByUserId == request.auth.uid
              )
              || (
                isAssigner(orgId)
                && request.resource.data.status == 'pending'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'assignerAckAt', 'assignerAckByUserId', 'assignerAckByName', 'updatedAt'
                  ])
                && request.resource.data.assignerAckByUserId == request.auth.uid
              )
            );
          allow delete: if isAssigner(orgId);
        }
        match /gameRequests/{requestId} {
          allow read: if isAssigner(orgId)
            || (signedIn() && resource.data.userId == request.auth.uid);
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow update: if isAssigner(orgId)
            || (signedIn() && resource.data.userId == request.auth.uid);
          allow delete: if signedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending';
        }
      }
      match /fixtureRequests/{requestId} {
        allow read: if isMember(orgId);
        allow create: if signedIn()
          && request.resource.data.requesterUserId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasAll([
            'orgId', 'requesterUserId', 'requesterName', 'requesterTeamId',
            'side', 'opponentTeamId', 'homeTeamId', 'awayTeamId',
            'homeTeamName', 'awayTeamName', 'kickoffAt', 'venueName',
            'venueAddress', 'level', 'gender', 'flightProvided',
            'housingProvided', 'status', 'createdAt'
          ]);
        // Assigner may decline; approve + Sheet append is Admin SDK only.
        allow update: if isAssigner(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'declineReason', 'reviewedAt', 'reviewedByUserId',
              'updatedAt'
            ]);
        allow delete: if isAssigner(orgId);
      }
      /**
       * Team Admin referee feedback — club-owned, Scheduler-confidential.
       * Officials must never read. Doc id = matchId_reportingTeamId.
       */
      match /coachFeedback/{feedbackId} {
        function memberDoc() {
          return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
        }
        function isTeamAdminForReportingTeam() {
          return isMember(orgId)
            && 'teamAdmin' in memberDoc().roles
            && request.resource.data.reportingTeamId in memberDoc().teamIds;
        }
        function canReadClubFeedback() {
          return isMember(orgId)
            && 'teamAdmin' in memberDoc().roles
            && resource.data.reportingTeamId in memberDoc().teamIds;
        }
        function matchPath() {
          return /databases/$(database)/documents/orgs/$(orgId)/matches/$(request.resource.data.matchId);
        }
        function matchAllowsCoachFeedback() {
          return exists(matchPath())
            && get(matchPath()).data.homeTeamId == request.resource.data.homeTeamId
            && get(matchPath()).data.awayTeamId == request.resource.data.awayTeamId
            && get(matchPath()).data.kickoffAt == request.resource.data.kickoffAt
            && !(get(matchPath()).data.status in ['cancelled', 'draft', 'postponed'])
            && crewVisible(get(matchPath()).data)
            && (
              request.resource.data.reportingTeamId == get(matchPath()).data.homeTeamId
              || request.resource.data.reportingTeamId == get(matchPath()).data.awayTeamId
            );
        }
        function coachFeedbackIdOk() {
          return request.resource.data.id == feedbackId
            && feedbackId == request.resource.data.matchId + '_' + request.resource.data.reportingTeamId;
        }
        function coachFeedbackStatusOk() {
          return request.resource.data.status in ['draft', 'submitted', 'declined'];
        }
        function coachFeedbackCreateShape() {
          return request.resource.data.keys().hasAll([
            'id', 'orgId', 'matchId', 'slot', 'officialUserId', 'officialName',
            'homeTeamId', 'homeTeamName', 'awayTeamId', 'awayTeamName',
            'kickoffAt', 'level', 'score', 'scales', 'submitterUserId',
            'submitterName', 'submitterEmail', 'clubRole', 'reportingTeamId',
            'reportingTeamName', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.orgId == orgId
          && coachFeedbackIdOk()
          && request.resource.data.slot == 'mo'
          && coachFeedbackStatusOk()
          && request.resource.data.submitterUserId == request.auth.uid
          && request.resource.data.officialUserId is string
          && request.resource.data.officialUserId.size() > 0
          && request.resource.data.officialName is string
          && request.resource.data.officialName.size() > 0
          && request.resource.data.scales is map
          && matchAllowsCoachFeedback();
        }
        allow read: if isAssigner(orgId) || canReadClubFeedback();
        allow create: if signedIn()
          && isTeamAdminForReportingTeam()
          && coachFeedbackCreateShape();
        allow update: if signedIn()
          && isTeamAdminForReportingTeam()
          && resource.data.matchId == request.resource.data.matchId
          && resource.data.reportingTeamId == request.resource.data.reportingTeamId
          && resource.data.orgId == request.resource.data.orgId
          && resource.data.id == request.resource.data.id
          && coachFeedbackIdOk()
          && request.resource.data.slot == 'mo'
          && coachFeedbackStatusOk()
          && request.resource.data.submitterUserId == request.auth.uid
          && request.resource.data.scales is map
          && matchAllowsCoachFeedback();
        allow delete: if isAssigner(orgId);
      }
      /** Team Admin club-link requests — create/review via Admin SDK callables. */
      match /teamLinkRequests/{requestId} {
        allow read: if isMember(orgId);
        allow create, update, delete: if false;
      }
      match /availability/{uid}/ranges/{rangeId} {
        allow read: if isAssigner(orgId) || request.auth.uid == uid;
        allow write: if request.auth.uid == uid;
      }
    }
  }
}
