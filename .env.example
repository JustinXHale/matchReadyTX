# MatchReadyTX env template
# Copy to .env.local for local Vite; set Functions secrets in Firebase Console.

# Showcase — `/demo`, Try demo, Open demo in masthead when true (you want true for societies tour).
# VITE_DEMO_MODE=true

# Firebase web config (required for real Google/Apple sign-in)
# AUTH_DOMAIN: use your Hosting host (e.g. matchreadytx.web.app), not *.firebaseapp.com
# Note: project default site is matchreadytx.web.app (no hyphen). Verify in Firebase Hosting.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_DEFAULT_ORG_ID=lonestar

# App Check — reCAPTCHA Enterprise site key (public; from GCP Fraud Defense key details)
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev with enforcement: VITE_APP_CHECK_DEBUG=true then register debug token in Firebase App Check

# Public PWA origin for deep links in assignment emails (production Hosting URL).
# If unset, emails use the browser origin of whoever triggered the send.
# VITE_APP_ORIGIN=https://matchreadytx.web.app

# Cloud Functions / server (not exposed to Vite client bundle)
# GOOGLE_SERVICE_ACCOUNT_JSON=   # firebase functions:secrets:set GOOGLE_SERVICE_ACCOUNT_JSON
# SHEET_WEBHOOK_SECRET=          # firebase functions:secrets:set SHEET_WEBHOOK_SECRET (Apps Script WEBHOOK_SECRET)
# RESEND_API_KEY=                # firebase functions:secrets:set RESEND_API_KEY
# RESEND_FROM_EMAIL=MatchReadyTX <noreply@yourdomain.com>
