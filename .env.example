# MatchReadyTX env template
# Copy to .env.local for local Vite; set Functions secrets in Firebase Console.

# Showcase kill switch — `/demo`, Try demo, Demo|Live toggle. Does NOT disable
# Google/Apple when VITE_FIREBASE_* is set. Use false to hide the showcase.
VITE_DEMO_MODE=false

# Firebase web config (required for real Google/Apple sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_DEFAULT_ORG_ID=lonestar

# Public PWA origin for deep links in assignment emails (production Hosting URL).
# If unset, emails use the browser origin of whoever triggered the send.
# VITE_APP_ORIGIN=https://matchreadytx.web.app

# Cloud Functions / server (not exposed to Vite)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# RESEND_API_KEY=          # firebase functions:secrets:set RESEND_API_KEY
# RESEND_FROM_EMAIL=MatchReadyTX <noreply@yourdomain.com>
